# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values are ever exposed to the browser.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never import from client code.
SUPABASE_SECRET_KEY=

# --- AI (Claude via Vercel AI SDK) ------------------------------------------
# Server-only. The model ID is configuration, e.g. claude-haiku-5-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- PayPal Sandbox ----------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# Sandbox buyer (Personal account) that approves the PayPal popup in live E2E runs.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# --- Request form, status pages, Gmail (optional) ---------------------------
# Public origin for links and the Google redirect. Leave empty to use the
# request's own host (works for localhost and the Vercel domain).
SETTLIX_SITE_URL=
# Google OAuth client (Web application) for "Connect Gmail". Authorized
# redirect URI: <origin>/api/integrations/gmail/callback. Server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts Gmail
# tokens at rest; changing it means reconnecting Gmail. Server-only.
SETTLIX_ENCRYPTION_KEY=
# Vercel Cron sends it as a Bearer token to /api/cron/gmail-sync (daily check).
CRON_SECRET=

# --- Tests (never set in a deployed environment) -----------------------------
# Lets the E2E suite request named fault scenarios; ignored in production builds.
SETTLIX_TEST_FAULTS=
# Run the live E2E specs (real PayPal Sandbox checkout and refunds, real Claude).
E2E_LIVE=
