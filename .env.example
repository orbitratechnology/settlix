# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* values are ever exposed to the browser.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...). Never import from client code.
SUPABASE_SECRET_KEY=

# --- AI (Claude via Vercel AI SDK) ------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- PayPal Sandbox ----------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
